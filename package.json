{
  "name": "@lxtzfr/wt",
  "version": "1.0.0",
  "description": "Worktree slots for multi-repo dev: one slot per ticket, its own ports, links between repos in .env.local",
  "license": "MIT",
  "type": "module",
  "repository": "github:lxtzfr/wt",
  "bin": {
    "wt": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
